# ==============================================================================
# Portfolio Environment Configuration Template
# Copy this file to .env.local for local development or set variables in Vercel.
# DO NOT commit real secrets or production keys into version control.
# ==============================================================================

# --- Database Storage: Supabase (Primary Production Adapter) ---
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
# SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Database Storage: Upstash / Vercel KV (Secondary Adapter) ---
# KV_REST_API_URL=https://your-kv-instance.upstash.io
# KV_REST_API_TOKEN=your-kv-rest-token

# --- Email Notifications: Resend (Optional) ---
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM_EMAIL=Portfolio Contact <notifications@yourdomain.com>

# --- Admin Contact Submissions Review ---
# ADMIN_API_KEY=your-secure-random-admin-secret-for-api-messages-endpoint
